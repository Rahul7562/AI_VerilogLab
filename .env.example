# Copy to .env and fill in. NEVER commit .env with a real key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=stealth/space-bunny-alpha
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional thinking control (code default is low): exclude|low|medium|high|off
#VLAB_REASONING_EFFORT=low
# LLM retry budget for rate limits (default 2 extra attempts with backoff)
#VLAB_LLM_RETRIES=2
# Optional tracking headers for OpenRouter
OPENROUTER_APP_URL=http://localhost
OPENROUTER_APP_NAME=AI-VerilogLab
