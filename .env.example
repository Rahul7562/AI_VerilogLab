# Copy to .env and fill in. NEVER commit .env with a real key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=stealth/space-bunny-alpha
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional thinking control:
#   off | exclude | low | medium | high | tokens
# `effort` and `max_tokens` are mutually exclusive at the API (HTTP 400 if
# both are sent), so this picks one. "tokens" uses VLAB_REASONING_MAX_TOKENS.
# Verified working with the default model: low | exclude | tokens.
VLAB_REASONING_EFFORT=low
# VLAB_REASONING_MAX_TOKENS=512
# LLM retry budget PER MODEL (default 2) before rotating to the next model.
#VLAB_LLM_RETRIES=2
# Minimum seconds between LLM calls (client-side pacing, default 3.0)
#VLAB_LLM_MIN_INTERVAL=3.0
# Free-tier limits are per-model, so vlab rotates through these on 429/5xx.
# `vlab models --probe` shows which are live. Empty disables rotation.
# The primary is excluded from the pool (it is the first entry tried).
#VLAB_LLM_FALLBACKS=cohere/north-mini-code:free,inclusionai/ling-3.0-flash-sante:free
# Optional tracking headers for OpenRouter
OPENROUTER_APP_URL=http://localhost
OPENROUTER_APP_NAME=AI-VerilogLab
